<Window
    x:Class="JsonXmlForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JSON &amp; XML Forge">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Format" Label="Prettify JSON" Click="OnPrettifyJsonClicked"/>
            <AppBarButton Icon="Document" Label="Prettify XML" Click="OnPrettifyXmlClicked"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Switch" Label="Minify Text" Click="OnMinifyClicked"/>
            <AppBarButton Icon="Clear" Label="Clear" Click="OnClearClicked"/>
        </CommandBar>

        <Grid Grid.Row="1" Margin="0,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="TxtInput" Header="Input Raw Buffer" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
            <TextBox Grid.Column="1" x:Name="TxtOutput" Header="Formatted Output" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True"/>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>
