<Window
    x:Class="FileChecksumValidator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="File Checksum Validator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="File Checksum Validator" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Calculate and verify cryptographic hashes for file integrity assurance." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFilePath" PlaceholderText="Select or enter path to file..."/>
                <Button Grid.Column="1" Content="Compute Hashes" Click="OnComputeClicked"/>
            </Grid>

            <TextBox x:Name="TxtExpected" Header="Expected Hash (Optional for matching verification)" PlaceholderText="Paste target checksum here..."/>
            <Button Content="Verify Match" Click="OnVerifyClicked"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBox x:Name="TxtMd5" Header="MD5" IsReadOnly="True"/>
                    <TextBox x:Name="TxtSha1" Header="SHA-1" IsReadOnly="True"/>
                    <TextBox x:Name="TxtSha256" Header="SHA-256" IsReadOnly="True"/>
                    <TextBox x:Name="TxtSha512" Header="SHA-512" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtResult" Text="Ready" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
