<Window
    x:Class="ImageResizerFluid.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Image Resizer Fluid">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="Image Resizer Fluid" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Scale images, compute aspect ratios, and convert graphics formats." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBox x:Name="TxtSourcePath" Header="Source Image Path" PlaceholderText="C:\path\to\image.png"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtWidth" Header="Target Width" Text="1920"/>
                <TextBox Grid.Column="1" x:Name="TxtHeight" Header="Target Height" Text="1080"/>
            </Grid>

            <CheckBox x:Name="ChkLockAspect" Content="Lock Aspect Ratio (16:9)" IsChecked="True"/>

            <ComboBox x:Name="ComboFormat" Header="Target Format" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="PNG (Portable Network Graphics)"/>
                <ComboBoxItem Content="JPEG (Joint Photographic Experts Group)"/>
                <ComboBoxItem Content="WEBP (Modern Web Format)"/>
                <ComboBoxItem Content="BMP (Windows Bitmap)"/>
            </ComboBox>

            <Button Content="Execute Resize Pipeline" HorizontalAlignment="Stretch" Click="OnResizeClicked"/>
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
