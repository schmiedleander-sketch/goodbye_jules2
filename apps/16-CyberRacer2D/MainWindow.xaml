<Window
    x:Class="CyberRacer2D.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cyber Racer 2D - GACL DirectStorage Pipeline">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command & Diagnostics -->
        <CommandBar Grid.Row="0">
            <AppBarButton Icon="Play" Label="Start Race" Click="OnStartClicked"/>
            <AppBarButton Icon="Pause" Label="Pause" Click="OnPauseClicked"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Setting" Label="Condition Textures (GACL)" Click="OnConditionTexturesClicked"/>
        </CommandBar>

        <!-- Game Canvas & GACL Overlay -->
        <Grid Grid.Row="1" Margin="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 2D Viewport -->
            <Border Grid.Column="0" Background="#0f0f1b" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Canvas x:Name="GameCanvas" Width="600" Height="400">
                    <TextBlock Canvas.Left="20" Canvas.Top="20" Text="SPEED: 185 MPH" Foreground="#00FFCC" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Canvas.Left="20" Canvas.Top="50" Text="POS: 1 / 8" Foreground="#FFCC00" FontSize="16"/>
                    <Rectangle Canvas.Left="280" Canvas.Top="300" Width="40" Height="70" Fill="#FF0055" RadiusX="4" RadiusY="4"/>
                </Canvas>
            </Border>

            <!-- GACL Texture Pipeline Inspector -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="GACL DirectStorage Pipeline" FontWeight="SemiBold"/>
                    <TextBlock Text="Active Format: BC7 (ZSTD_BC7_SPLIT)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ProgressBar x:Name="GaclProgress" Value="100"/>
                    <TextBlock x:Name="TxtCompressionRatio" Text="Compression: 48.2% reduction (Zstd+Split)"/>
                    <TextBlock x:Name="TxtBlerMetric" Text="BLER Entropy Reduction: Active (42.5 dB PSNR)"/>
                    <TextBlock x:Name="TxtTileMicroorder" Text="Space Curve: 16KB Z-order micro-tiles"/>
                    <TextBox x:Name="TxtLog" Header="Pipeline Stream Log" Height="180" AcceptsReturn="True" FontFamily="Consolas" IsReadOnly="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}" Padding="16,6">
            <TextBlock x:Name="TxtStatus" Text="Ready: 60 FPS | GACL DirectStorage 1.4 Streaming Active" Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Border>
    </Grid>
</Window>
