<Window
    x:Class="AudioWaveLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Audio Wave Lab">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Audio Wave Lab" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="Synthesize tone frequencies and export audio WAV streams." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="Waveform Type"/>
            <ComboBox x:Name="ComboWaveType" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Sine Wave"/>
                <ComboBoxItem Content="Square Wave"/>
                <ComboBoxItem Content="Sawtooth Wave"/>
            </ComboBox>

            <TextBlock Text="Frequency (Hz):"/>
            <Slider x:Name="SliderFreq" Minimum="100" Maximum="2000" Value="440" StepFrequency="10"/>
            <TextBlock x:Name="TxtFreqDisplay" Text="440 Hz" FontWeight="SemiBold"/>

            <TextBlock Text="Duration (Seconds):"/>
            <Slider x:Name="SliderDuration" Minimum="1" Maximum="10" Value="2"/>
            <TextBlock x:Name="TxtDurationDisplay" Text="2 Seconds" FontWeight="SemiBold"/>

            <Button Content="Generate and Export WAV File" HorizontalAlignment="Stretch" Click="OnGenerateWavClicked"/>
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
