<Window
    x:Class="TaskManagerPlus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskManagerPlus"
    Title="Task Manager Plus - Windows App SDK">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command Bar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" Click="OnRefreshClicked"/>
            <AppBarButton Icon="Cancel" Label="End Task" Click="OnEndTaskClicked"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Filter" Label="Filter"/>
        </CommandBar>

        <!-- Metrics Dashboard -->
        <Grid Grid.Row="1" Margin="20,10,20,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Total Processes" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalProcesses" Text="0" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Total Working Set Memory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalMemory" Text="0 MB" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Search / Filter" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="TxtSearch" PlaceholderText="Search by process name..." TextChanged="OnSearchTextChanged" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Process List -->
        <ListView Grid.Row="2" x:Name="ProcessListView" Margin="20,0,20,10" SelectionMode="Single">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="12,8,12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PID" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Process Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Memory (MB)" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Threads" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Start Time" FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProcessItem">
                    <Grid Padding="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Id}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ProcessName}" FontWeight="Medium"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind MemoryMB}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind ThreadsCount}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind StartTime}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorAltBrush}" Padding="20,8,20,8">
            <TextBlock x:Name="TxtStatus" Text="Ready" Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Border>
    </Grid>
</Window>
