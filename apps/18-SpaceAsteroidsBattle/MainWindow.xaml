<Window
    x:Class="SpaceAsteroidsBattle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Space Asteroids Battle - GACL BC7 Asset Compression">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0">
            <AppBarButton Icon="Play" Label="Fire Laser" Click="OnFireClicked"/>
            <AppBarButton Icon="Refresh" Label="Spawn Wave" Click="OnSpawnWaveClicked"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Sync" Label="Run GACL Shuffle" Click="OnGaclShuffleClicked"/>
        </CommandBar>

        <Grid Grid.Row="1" Margin="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Space Canvas -->
            <Border Grid.Column="0" Background="#050510" CornerRadius="8">
                <Canvas x:Name="SpaceCanvas">
                    <TextBlock Canvas.Left="20" Canvas.Top="20" Text="SCORE: 12,450" Foreground="#00FF88" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Canvas.Left="20" Canvas.Top="50" Text="SHIELDS: 100%" Foreground="#00AAFF" FontSize="16"/>
                    <Polygon Points="300,200 280,240 320,240" Fill="#FFFFFF"/>
                </Canvas>
            </Border>

            <!-- GACL Details -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="GACL Texture Pipeline" FontWeight="SemiBold"/>
                    <TextBlock Text="Target: High-Fidelity Ship &amp; Asteroid Textures"/>
                    <TextBox x:Name="TxtGaclLog" Header="Shuffle &amp; Unshuffle Info" Height="220" AcceptsReturn="True" FontFamily="Consolas" IsReadOnly="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
