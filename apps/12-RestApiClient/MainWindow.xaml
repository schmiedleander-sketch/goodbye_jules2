<Window
    x:Class="RestApiClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="REST API Client">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="REST API Client" Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,12"/>

        <!-- Request URL Bar -->
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ComboMethod" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="GET"/>
                <ComboBoxItem Content="POST"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="DELETE"/>
            </ComboBox>

            <TextBox Grid.Column="1" x:Name="TxtUrl" Text="https://api.github.com/repos/microsoft/WindowsAppSDK"/>
            <Button Grid.Column="2" Content="Send Request" Click="OnSendClicked"/>
        </Grid>

        <!-- Response Body -->
        <TextBox Grid.Row="2" x:Name="TxtResponseBody" Header="HTTP Response Body" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True"/>

        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Text="Ready" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>
