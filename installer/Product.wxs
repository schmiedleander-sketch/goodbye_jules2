<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Windows App SDK Suite and GACL Games"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="Windows App SDK Community"
           UpgradeCode="B9F74C78-751D-49AE-BE09-3221C390B752">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Installer for 20 Windows App SDK Applications and GACL Game Integrations" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WindowsAppSDKSuite">
        <Component Id="cmp_TaskManagerPlus" Guid="{328F5D74-33CC-50BD-8846-1DA2B6ECB99E}">
          <File Id="fil_TaskManagerPlus" Source="$(var.SourceDir)\TaskManagerPlus\TaskManagerPlus.exe" KeyPath="yes">
            <Shortcut Id="startMenuShortcut_TaskManagerPlus"
                      Directory="ProgramMenuDir"
                      Name="Task Manager Plus"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>
        </Component>
        <Component Id="cmp_MarkdownNotePad" Guid="{54262B6B-5691-5EA1-9CA1-89B9B3F0D489}">
