                      Directory="ProgramMenuDir"
                      Name="Markdown NotePad"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>
        </Component>
        <Component Id="cmp_DevPalette" Guid="{E18792A3-103E-5C74-9C36-701715A953BA}">
