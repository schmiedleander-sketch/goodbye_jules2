        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Windows App SDK Suite">
          <Component Id="cmp_ProgramMenuDir" Guid="D2A68153-61B7-4D6C-A63F-5FE015B78263">
            <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\WindowsAppSDKSuite" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
