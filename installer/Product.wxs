        <Component Id="cmp_RetroPlatformerJump" Guid="{2CBB7812-2B24-58B6-87E5-4D21F9B23A56}">
          <File Id="fil_RetroPlatformerJump" Source="$(var.SourceDir)\RetroPlatformerJump\RetroPlatformerJump.exe" KeyPath="yes">
            <Shortcut Id="startMenuShortcut_RetroPlatformerJump"
